name: Build Vyapar Sarathi APK

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "17"
          cache: gradle

      - name: Check Android project
        run: |
          echo "Checking project files..."
          ls -la
          echo "Gradle files:"
          find . -maxdepth 3 -type f \( -name "build.gradle" -o -name "build.gradle.kts" -o -name "settings.gradle" -o -name "settings.gradle.kts" -o -name "gradlew" \) -print

      - name: Make Gradle executable
        run: |
          if [ ! -f "./gradlew" ]; then
            echo "ERROR: gradlew file not found!"
            exit 1
          fi
          chmod +x ./gradlew

      - name: Clean project
        run: ./gradlew clean

      - name: Build Debug APK
        run: ./gradlew assembleDebug --stacktrace

      - name: Find APK
        run: |
          echo "APK files:"
          find app/build/outputs/apk -type f -name "*.apk" -print

      - name: Rename APK
        run: |
          mkdir -p release
          cp app/build/outputs/apk/debug/*.apk release/Vyapar-Sarathi.apk

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Vyapar-Sarathi-APK
          path: release/Vyapar-Sarathi.apk

      - name: Create GitHub Release
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: release/Vyapar-Sarathi.apk
          generate_release_notes: true
          name: Vyapar Sarathi ${{ github.ref_name }}
          body: |
            ## Vyapar Sarathi

            Android APK release.

            APK: Vyapar-Sarathi.apk
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
